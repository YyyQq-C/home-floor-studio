{
  "name": "home-floor-studio",
  "version": "0.1.0",
  "description": "独立户型编辑及 Home Assistant 展示工具",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "vitest run",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:ha": "vite build --config vite.ha.config.ts",
    "predev": "npm run build:ha && node scripts/stage-ha.mjs",
    "prebuild": "npm run build:ha && node scripts/stage-ha.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YyyQq-C/home-floor-studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bugs": {
    "url": "https://github.com/YyyQq-C/home-floor-studio/issues"
  },
  "homepage": "https://github.com/YyyQq-C/home-floor-studio#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
